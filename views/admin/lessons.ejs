<div class="page-head">
  <div>
    <h1>Lessons — <%= chapter.title %></h1>
    <p class="muted">
      Course: <strong><%= chapter.course_title %></strong>
    </p>
  </div>

  <a class="btn btn-secondary" href="/admin/courses/<%= chapter.course_id %>/chapters">
    ← Back to chapters
  </a>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="admin-grid">
  <!-- Create lesson -->
  <section class="card">
    <h2>Create a lesson</h2>

    <form method="POST" action="/admin/chapters/<%= chapter.id %>/lessons" class="form">
      <div class="field">
        <label for="title">Lesson title</label>
        <input id="title" name="title" required />
           <div class="field">
            <label for="objective">Objectif (1–3 phrases)</label>
            <textarea id="objective" name="objective" rows="3"></textarea>
           </div>

           <div class="field">
            <label for="exam_points">Ce qui tombe à l’examen (1 item per line)</label>
            <textarea id="exam_points" name="exam_points" rows="5" placeholder="- Type de  question 1&#10;- Type de question 2&#10;- Piège fréquent"></textarea>
           </div>

           <div class="field">
            <label for="common_mistakes">Erreurs fréquentes (1 item per line)</label>
            <textarea id="common_mistakes" name="common_mistakes" rows="5" placeholder="- Erreur 1 → correction&#10;- Erreur 2 → correction"></textarea>
           </div>

           </div>

          <div class="field">
           <label for="position">Position (order)</label>
           <input id="position" name="position" type="number" value="0" />
          </div>

          <div class="field">
           <label for="content">Content (optional)</label>
           <textarea id="content" name="content" rows="6"></textarea>
          </div>
      <button class="btn btn-primary" type="submit">Add Lesson</button>
    </form>
  </section>

  <!-- List lessons -->
  <section class="card">
    <h2>Existing lessons</h2>

    <% if (!lessons || lessons.length === 0) { %>
      <p class="muted">No lessons yet. Create the first one.</p>
    <% } else { %>
      <ul class="admin-list">
        <% lessons.forEach(ls => { %>
          <li class="admin-item">
            <div class="admin-item-main">
              <div class="admin-pill">#<%= ls.position %></div>
              <div>
                <div class="admin-title"><%= ls.title %></div>
                <div class="admin-actions">
                  <a class="btn btn-secondary btn-sm" href="/admin/lessons/<%= ls.id %>/files">Resources</a>
                  <a class="btn btn-secondary btn-sm" href="/admin/lessons/<%= ls.id %>/edit">Edit</a>
                  <form method="POST" action="/admin/lessons/<%= ls.id %>/delete" class="inline">
                    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
