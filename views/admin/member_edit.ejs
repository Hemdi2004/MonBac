<h1>Modifier le membre : <%= student.name %></h1>

<% if (error) { %>
  <p style="color:red;"><%= error %></p>
<% } %>

<div class="card">
  <form method="POST" action="/admin/members/<%= student.id %>/edit">
    <div class="field">
      <label>Nom Complet</label>
      <input type="text" name="name" value="<%= student.name %>" required />
    </div>

    <div class="field">
      <label>Numéro WhatsApp</label>
      <input type="text" name="whatsapp" value="<%= student.whatsapp %>" required />
    </div>

    <div class="field">
      <label>Groupe / Niveau</label>
      <select name="group_id" required>
        <% groups.forEach(g => { %>
          <option value="<%= g.id %>" <%= Number(g.id) === Number(membership.group_id) ? 'selected' : '' %>>
            [<%= g.level %>] <%= g.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="actions" style="margin-top: 20px;">
      <button type="submit" class="btn btn-primary">Enregistrer</button>
      <a href="/admin/groups/<%= membership.group_id %>/members" class="btn btn-secondary">Annuler</a>
    </div>
  </form>
</div>
