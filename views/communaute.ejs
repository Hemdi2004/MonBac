<header class="home-hero">
  <p class="badge"><%- __("community_badge") %></p>
  <h1 class="home-title"><%- __("community_title") %></h1>
  <p class="lead"><%- __("community_lead") %></p>

  <div class="cta-row">
    <a class="btn btn-primary" href="/inscription"><%- __("community_btn_join") %></a>
    <a class="btn btn-secondary" href="/professeur"><%- __("community_btn_prof") %></a>
  </div>

  <p class="muted"><%- __("community_muted") %></p>
</header>

<section class="grid">
  <!-- Why Join Card -->
  <article class="card">
    <h2><%- __("community_why") %></h2>
    <p class="muted"><%- __("community_why_muted") %></p>
    <ul class="list">
      <li><%- __("community_why_1") %></li>
      <li><%- __("community_why_2") %></li>
      <li><%- __("community_why_3") %></li>
      <li><%- __("community_why_4") %></li>
    </ul>
  </article>

  <!-- Educational Levels Card -->
  <article class="card">
    <h2><%- __("community_levels") %></h2>
    <p class="muted"><%- __("community_levels_muted") %></p>
    <ul class="list">
      <li><%- __("prof_for_2bac") %></li>
      <li><%- __("prof_for_1bac") %></li>
      <li><%- __("prof_for_college") %></li>
    </ul>
  </article>

  <!-- Organization Card -->
  <article class="card">
    <h2><%- __("community_org") %></h2>
    <p class="muted"><%- __("community_org_muted") %></p>
    <ul class="list">
      <li><%- __("community_org_1") %></li>
      <li><%- __("community_org_2") %></li>
      <li><%- __("community_org_3") %></li>
      <li><%- __("community_org_4") %></li>
    </ul>
  </article>
</section>

<!-- Onboarding Process Section -->
<section class="card">
  <h2><%- __("community_how") %></h2>
  <ol class="steps">
    <li><%- __("community_how_1") %></li>
    <li><%- __("community_how_2") %></li>
    <li><%- __("community_how_3") %></li>
    <li><%- __("community_how_4") %></li>
  </ol>

  <div class="cta-box">
    <div class="cta-text-wrapper">
      <h3><%- __("community_ready") %></h3>
      <p class="muted"><%- __("community_ready_muted") %></p>
    </div>
    <a class="btn btn-primary" href="/inscription"><%- __("community_btn_join_short") %></a>
  </div>

  <p class="muted"><%- __("community_no_pay") %></p>
</section>
