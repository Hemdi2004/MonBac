<nav class="breadcrumb">
  <a href="/">Accueil</a>
  <span class="sep">›</span>
  <span class="current"><%= course.title %></span>
</nav>
<a class="btn btn-secondary" href="javascript:history.back()">← Retour</a>
<header class="course-hero card">
  <p class="badge">Bac Maroc</p>
  <h1 class="course-title"><%= course.title %></h1>

  <% if (course.description) { %>
    <p class="lead"><%= course.description %></p>
  <% } else { %>
    <p class="lead">
      Chapitres, leçons, exercices et corrigés pour progresser étape par étape.
    </p>
  <% } %>

  <p class="muted">
    Conseil : commencez par le premier chapitre, puis suivez l’ordre des leçons.
  </p>
</header>

<section class="course-contents">
  <h2 class="section-title">Chapitres & Leçons</h2>

  <% if (!chapters || chapters.length === 0) { %>
    <div style="text-align: center; padding: 4rem 1rem; border: 2px dashed #e5e7eb; border-radius: 16px; background: #fafafa; margin: 2rem 0;">
      <i data-lucide="book-dashed" style="width: 56px; height: 56px; color: #9ca3af; margin-bottom: 1rem;"></i>
      <h3 style="font-size: 1.3rem; color: #4b5563; margin: 0 0 0.5rem 0;">Aucun contenu pour le moment</h3>
      <p style="color: #9ca3af; margin: 0; font-size: 1.05rem;">Ce cours vient d'être créé. Le professeur ajoute les chapitres bientôt !</p>
    </div>
  <% } else { %>
    <div class="chapters-grid">
      <% (chapters || []).forEach(ch => { %>
        <article class="chapter card">
          <h3 class="chapter-title"><%= ch.title %></h3>

          <ul class="lesson-list">
            <% 
              const lessonList = (lessons || []).filter(ls => Number(ls.chapter_id) === Number(ch.id));
            %>

            <% if (lessonList.length === 0) { %>
              <li style="text-align: center; padding: 2rem 1rem; border: 1px dashed #e5e7eb; border-radius: 12px; background: #f9fafb; list-style: none;">
                 <i data-lucide="file-x" style="width: 32px; height: 32px; color: #d1d5db; margin-bottom: 0.5rem;"></i>
                 <p style="color: #9ca3af; margin: 0; font-size: 0.95rem;">Les leçons de ce chapitre arrivent bientôt.</p>
              </li>
            <% } else { %>
              <% lessonList.forEach((ls, idx) => { %>
                <li>
                  <a class="lesson-link" href="/lesson/<%= ls.id %>">
                    <span class="lesson-left">
                      <span class="lesson-num"><%= (ls.position ?? (idx + 1)) %></span>
                      <span class="lesson-name"><%= ls.title %></span>
                    </span>
                    <span class="lesson-arrow">→</span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card course-help">
  <h2>Besoin d’un accompagnement pour ce cours ?</h2>
  <p class="muted">
    Cours à distance et groupes de révision disponibles. Indiquez le chapitre/la leçon et votre objectif.
  </p>
  <div class="cta-row">
    <a class="btn btn-primary" href="/professeur">Contacter le professeur</a>
    <a class="btn btn-secondary" href="/">← Retour aux cours</a>
  </div>
</section>
