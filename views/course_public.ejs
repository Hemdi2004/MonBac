<div class="course-page" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<nav class="breadcrumb">
  <a href="/"><%= __('breadcrumb_home') %></a>
  <span class="sep">›</span>
  <span class="current"> <%= __(course.title) %></span>
</nav>

<a class="btn btn-secondary" href="/"><%= __('btn_return') %></a>

<header class="course-hero card">
  <p class="badge"><%= __('course_badge') %></p>
  <h1 class="course-title"><%= __(course.title) %></h1>


    <p class="lead">
      <%= __('course_intro_fallback') %>
    </p>


  <p class="muted">
    <%= __('course_start_advice') %>
  </p>
</header>

<section class="course-contents">
  <h2 class="section-title"><%= __('course_contents_title') %></h2>

  <% if (!chapters || chapters.length === 0) { %>
    <!-- Clean, semantic empty state block utilizing component-level empty CSS classes -->
    <div class="empty-state empty-state-dashed">
      <i data-lucide="book-open" class="empty-state-icon"></i>
      <h3 class="empty-state-heading"><%= __('course_empty_title') %></h3>
      <p class="empty-state-text"><%= __('course_empty_desc') %></p>
    </div>
  <% } else { %>
    <div class="chapters-grid">
      <% chapters.forEach(chapter => { %>
        <article class="chapter card">
          <% const filteredLessons = (lessons || []).filter(lesson => String(lesson.chapter_id) === String(chapter.id)); %>
          <header class="chapter-header">
            <div class="chapter-heading">
              <span class="chapter-mark" aria-hidden="true"><i data-lucide="layers"></i></span>
              <div>
                <p class="chapter-eyebrow"><%= __('course_chapter_label') %> <%= chapter.position %></p>
                <h3 class="chapter-title"><%= __(chapter.title.trim()) %></h3>
              </div>
            </div>
            <span class="chapter-count"><%= filteredLessons.length %> <%= filteredLessons.length === 1 ? __('course_lesson_singular') : __('course_lesson_plural') %></span>
          </header>

          <ul class="lesson-list">

            <% if (filteredLessons.length === 0) { %>
              <li class="empty-state-item text-center">
                 <i data-lucide="file-x" class="empty-state-item-icon"></i>
                 <p class="empty-state-item-text"><%= __('course_no_lessons') %></p>
              </li>
            <% } else { %>
              <% filteredLessons.forEach((lesson, index) => { %>
                <li>
                  <a class="lesson-link" href="/lesson/<%= lesson.id %>">
                    <span class="lesson-left">
                      <i data-lucide="book-open" class="lesson-icon" aria-hidden="true"></i>
                      <span class="lesson-name"><%= __(lesson.title.trim()) %></span>
                    </span>
                    <span class="lesson-arrow">→</span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card course-help">
  <h2><%= __('course_help_title') %></h2>
  <p class="muted">
    <%= __('course_help_desc') %>
  </p>
  <div class="cta-row">
    <a class="btn btn-primary" href="/professeur"><%= __('course_contact_teacher') %></a>
    <a class="btn btn-secondary" href="/"><%= __('course_back_courses') %></a>
  </div>
</section>
</div>
