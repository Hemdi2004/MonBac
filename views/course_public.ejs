<nav class="breadcrumb">
  <a href="/">Accueil</a>
  <span class="sep">›</span>
  <span class="current"><%= course.title %></span>
</nav>

<a class="btn btn-secondary" href="javascript:history.back()">← Retour</a>

<header class="course-hero card">
  <p class="badge">Bac Maroc</p>
  <h1 class="course-title"><%= course.title %></h1>

  <% if (course.description) { %>
    <p class="lead"><%= course.description %></p>
  <% } else { %>
    <p class="lead">
      Chapitres, leçons, exercices et corrigés pour progresser étape par étape.
    </p>
  <% } %>

  <p class="muted">
    Conseil : commencez par le premier chapitre, puis suivez l’ordre des leçons.
  </p>
</header>

<section class="course-contents">
  <h2 class="section-title">Chapitres & Leçons</h2>

  <% if (!chapters || chapters.length === 0) { %>
    <!-- Clean, semantic empty state block utilizing component-level empty CSS classes -->
    <div class="empty-state empty-state-dashed">
      <i data-lucide="book-open" class="empty-state-icon"></i>
      <h3 class="empty-state-heading">Aucun contenu pour le moment</h3>
      <p class="empty-state-text">Ce cours vient d'être créé. Le professeur ajoute les chapitres bientôt !</p>
    </div>
  <% } else { %>
    <div class="chapters-grid">
      <% chapters.forEach(chapter => { %>
        <article class="chapter card">
          <% const filteredLessons = (lessons || []).filter(lesson => String(lesson.chapter_id) === String(chapter.id)); %>
          <header class="chapter-header">
            <div class="chapter-heading">
              <span class="chapter-mark" aria-hidden="true"><i data-lucide="layers"></i></span>
              <div>
                <p class="chapter-eyebrow">Chapitre <%= chapter.position %></p>
                <h3 class="chapter-title"><%= chapter.title %></h3>
              </div>
            </div>
            <span class="chapter-count"><%= filteredLessons.length %> <%= filteredLessons.length === 1 ? 'leçon' : 'leçons' %></span>
          </header>

          <ul class="lesson-list">

            <% if (filteredLessons.length === 0) { %>
              <li class="empty-state-item text-center">
                 <i data-lucide="file-x" class="empty-state-item-icon"></i>
                 <p class="empty-state-item-text">Les leçons de ce chapitre arrivent bientôt.</p>
              </li>
            <% } else { %>
              <% filteredLessons.forEach((lesson, index) => { %>
                <li>
                  <a class="lesson-link" href="/lesson/<%= lesson.id %>">
                    <span class="lesson-left">
                      <i data-lucide="book-open" class="lesson-icon" aria-hidden="true"></i>
                      <span class="lesson-name"><%= lesson.title %></span>
                    </span>
                    <span class="lesson-arrow">→</span>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card course-help">
  <h2>Besoin d’un accompagnement pour ce cours ?</h2>
  <p class="muted">
    Cours à distance et groupes de révision disponibles. Indiquez le chapitre/la leçon et votre objectif.
  </p>
  <div class="cta-row">
    <a class="btn btn-primary" href="/professeur">Contacter le professeur</a>
    <a class="btn btn-secondary" href="/">← Retour aux cours</a>
  </div>
</section>
