<h1>Files for <%= course.title %></h1>

<!-- Upload form configuration -->
<form method="POST" action="/admin/courses/<%= course.id %>/upload" enctype="multipart/form-data">
  <input type="file" name="pdf" accept="application/pdf" required />
  <button type="submit">Upload PDF</button>
</form>

<!-- Document Listing -->
<% if (!files || files.length === 0) { %>
  <div class="empty-state-container" style="padding: 2rem 0; color: #6b7280;">
    <p>No documents have been uploaded to this course directory yet.</p>
  </div>
<% } else { %>
  <ul class="file-list">
    <% files.forEach(file => { %>
      <li class="file-item">
        <span class="file-name"><%= file.original_name %></span>
        <a href="/files/<%= file.id %>" class="btn-download" download>Download</a>
      </li>
    <% }) %>
  </ul>
<% } %>

<div class="navigation-actions" style="margin-top: 1.5rem;">
  <a href="/admin/courses" class="btn-back">Back to courses</a>
</div>
