<h1><%= __("g_schedule_title") %><%= group.name %></h1>

<p>
  <%= __("g_schedule_level") %><strong><%= group.level %></strong><%= __("g_schedule_type") %><strong><%= group.type %></strong>
</p>

<section class="schedule-card-wrapper">
  <% if (!sessions || sessions.length === 0) { %>
    <p><%= __("g_schedule_empty") %></p>
  <% } else { %>
    <table class="schedule-table">
      <thead>
        <tr>
          <th><%= __("g_schedule_th_prog") %></th>
          <th><%= __("g_schedule_th_date") %></th>
          <th><%= __("g_schedule_th_time") %></th>
          <th><%= __("g_schedule_th_title") %></th>
          <th><%= __("g_schedule_th_link") %></th>
        </tr>
      </thead>
      <tbody>
        <% sessions.forEach(sessionItem => { %>
          <tr>
            <td><%= sessionItem.program_title %></td>
            <td><%= sessionItem.session_date %></td>
            <td><%= sessionItem.session_time %></td>
            <td><%= sessionItem.title %></td>
            <td>
              <% if (sessionItem.meeting_link) { %>
                <a href="<%= sessionItem.meeting_link %>" target="_blank" rel="noopener noreferrer"><%= __("g_schedule_open") %></a>
              <% } else { %>
                &mdash;
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<p class="back-row">
  <a href="/emploi-du-temps" class="back-link"><%= __("g_schedule_back") %></a>
</p>
