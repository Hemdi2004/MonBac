<section class="home-hero home-hero--landing">
  <div class="home-hero__inner">
    <h1 class="home-hero__title">
      <%= __("hero_title_1") %> <span class="accent"><%= __("hero_title_2") %></span>
    </h1>
    <p class="home-hero__desc">
      <%= __("hero_desc") %>
    </p>
    <div class="home-hero__actions">
      <a href="#courses" class="btn btn-primary btn-lg">
        <i data-lucide="book-open"></i> <%= __("hero_btn_courses") %>
      </a>
      <a href="/communaute" class="btn btn-secondary btn-lg">
        <i data-lucide="users"></i> <%= __("hero_btn_community") %>
      </a>
    </div>
  </div>
</section>

<section id="courses" class="home-section">
  <h2 class="section-title"><%= __("home_courses_title") %></h2>

  <div class="tabs">
    <button class="tab-btn active" type="button" data-tab="2bac"><%= __("tab_2bac") %></button>
    <button class="tab-btn" type="button" data-tab="1bac"><%= __("tab_1bac") %></button>
    <button class="tab-btn" type="button" data-tab="college"><%= __("tab_college") %></button>
  </div>

  <div class="tab-panels">
    <% 
      // DRY optimization: Define categories and loop over them dynamically
      const categories = ["2bac", "1bac", "college"]; 
      categories.forEach(category => {
        const courseList = (groupedCourses && groupedCourses[category]) || [];
        const isActive = category === "2bac"; // Keep 2bac active by default
    %>
      <div class="tab-panel <%= isActive ? 'active' : '' %>" data-panel="<%= category %>">
        <% if (courseList.length === 0) { %>
          <div class="empty-state">
            <i data-lucide="folder-open" class="empty-state-icon"></i>
            <h3 class="empty-state-heading"><%= __("empty_course_title") %></h3>
            <p class="empty-state-text"><%= __("empty_course_desc") %></p>
          </div>
        <% } else { %>
          <ul class="course-grid">
            <% courseList.forEach(course => { %>
              <li class="course-card">
                <h3 class="course-title">
                  <a href="/course/<%= course.slug %>"><%= __(course.title) %></a>
                </h3>
              
                  <p class="muted"><%= __('course_intro_fallback') %></p>
                
                <a class="course-link" href="/course/<%= course.slug %>"><%= __("btn_access_course") %></a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<script>
  (function(){
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");

    tabButtons.forEach(button => {
      button.addEventListener("click", () => {
        const targetTab = button.dataset.tab;

        tabButtons.forEach(btn => btn.classList.toggle("active", btn === button));
        tabPanels.forEach(panel => panel.classList.toggle("active", panel.dataset.panel === targetTab));
      });
    });
  })();
</script>
