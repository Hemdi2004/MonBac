<%
  const displayResourceName = (filename) => {
    const safeFilename = String(filename || "");
    try {
      return decodeURIComponent(escape(safeFilename)).replace(/\.pdf$/i, "");
    } catch (error) {
      return safeFilename.replace(/\.pdf$/i, "");
    }
  };
%>

<div class="lesson-page" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<nav class="breadcrumb">
  <a href="/"><%= __('breadcrumb_home') %></a>
  <span class="sep">›</span>
  <a href="/course/<%= lesson.course_slug %>"><%= __(lesson.course_title.trim()) %></a>
  <span class="sep">›</span>
  <span class="current"><%= __(lesson.title.trim()) %></span>
</nav>
<a class="btn btn-secondary return-btn" href="/course/<%= lesson.course_slug %>"><%= __('btn_return') %></a>
<div class="lesson-layout">

  <!-- Sidebar TOC -->
  <aside class="toc card">
    <h3 class="toc-title"><%= __('course_plan') %></h3>

    <%
      const grouped = {};
      (toc || []).forEach(row => {
        if (!grouped[row.chapter_id]) {
          grouped[row.chapter_id] = { title: row.chapter_title, lessons: [] };
        }
        if (row.lesson_id) {
          grouped[row.chapter_id].lessons.push({
            id: row.lesson_id,
            title: row.lesson_title
          });
        }
      });

      const chapterOrder = [];
      const seen = new Set();
      (toc || []).forEach(r => {
        if (!seen.has(r.chapter_id)) {
          seen.add(r.chapter_id);
          chapterOrder.push(r.chapter_id);
        }
      });
    %>

    <div class="toc-groups">
      <% chapterOrder.forEach(chId => { %>
        <section class="toc-group">
          <div class="toc-chapter"><%= __(grouped[chId].title.trim()) %></div>

          <ul class="toc-list">
            <% grouped[chId].lessons.forEach(ls => { 
                 const isActive = Number(ls.id) === Number(lesson.id);
            %>
              <li>
                <a class="toc-link <%= isActive ? 'active' : '' %>" href="/lesson/<%= ls.id %>">
                  <%= __(ls.title.trim()) %>
                </a>
              </li>
            <% }) %>
          </ul>
        </section>
      <% }) %>
    </div>
  </aside>

  <!-- Main lesson content -->
  <section class="lesson-main">
    <header class="lesson-header">
      <h1 class="lesson-title"><%= __(lesson.title.trim()) %></h1>
      <p class="lesson-meta">
        <%= __('lesson_chapter_label') %> <strong><%= __(lesson.chapter_title.trim()) %></strong>
      </p>
    </header>

    <% if (lesson.content) { %>
      <div class="lesson-content card">
        <p><%= lesson.content %></p>
      </div>
    <% } %>

   <section class="lesson-body">
  <% if (lesson.objective && lesson.objective.trim()) { %>
    <div class="card lesson-panel">
      <h2><%= __('lesson_objective') %></h2>
      <p class="muted"><%= lesson.objective %></p>
    </div>
  <% } %>

  <% if (lesson.exam_points && lesson.exam_points.trim()) { %>
    <div class="card lesson-panel">
      <h2><%= __('lesson_exam_points') %></h2>
      <ul class="bullets">
        <% lesson.exam_points.split('\n').forEach(line => { %>
          <% if (line.trim()) { %>
            <li><%= line %></li>
          <% } %>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (lesson.common_mistakes && lesson.common_mistakes.trim()) { %>
    <div class="card lesson-panel">
      <h2><%= __('lesson_common_mistakes') %></h2>
      <ul class="bullets">
        <% lesson.common_mistakes.split('\n').forEach(line => { %>
          <% if (line.trim()) { %>
            <li><%= line %></li>
          <% } %>
        <% }) %>
      </ul>
    </div>
  <% } %>
</section>
    <section class="resources">
      <h2 class="section-title"><%= __('course_resources') %></h2>

      <div class="resource-block">
        <h3><%= __('course_explanations') %></h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'explanation').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'explanation')) { %>
            <div class="empty-inline">
              <i data-lucide="file-question"></i>
              <p><%= __('no_explanations_yet') %></p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resource-block">
        <h3><%= __('course_exercises') %></h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'exercise').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'exercise')) { %>
            <div class="empty-inline">
              <i data-lucide="file-question"></i>
              <p><%= __('no_exercises_yet') %></p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resource-block">
        <h3><%= __('course_solutions') %></h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'solution').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'solution')) { %>
            <div class="empty-inline">
              <i data-lucide="file-question"></i>
              <p><%= __('no_solutions_yet') %></p>
            </div>
          <% } %>
        </div>
      </div>
    </section>

<!-- ==========================================
     NEMOTRON AI TUTOR COMPONENT (Hackathon)
     ========================================== -->
<section class="ai-tutor-container card">
  <div class="ai-tutor-header">
    <span class="ai-tutor-icon">🤖</span> 
    <%= __('lesson_ai_title') %> : <%= __(lesson.title.trim()) %>
  </div>
  
  <div id="ai-chat-window" class="ai-chat-window">
    <div class="chat-bubble bubble-ai">
      <%= __('lesson_ai_intro') %> <strong>NVIDIA Nemotron</strong>. <%= __('lesson_ai_question_prompt') %> <em><%= __(lesson.chapter_title) %></em> ?
    </div>
  </div>

  <div class="ai-input-wrapper">
    <input type="hidden" id="lesson-context" value="Chapitre: <%= lesson.chapter_title %> | Leçon: <%= lesson.title %>">
    
    <input type="text" id="ai-input-field" class="ai-input-field" placeholder="<%= __('lesson_ai_placeholder') %>" onkeypress="if(event.key === 'Enter') submitAiQuestion()">
    <button class="ai-btn-submit" onclick="submitAiQuestion()"><%= __('lesson_ai_submit') %></button>
  </div>
</section>

<script>
  async function submitAiQuestion() {
    const inputField = document.getElementById('ai-input-field');
    const chatWindow = document.getElementById('ai-chat-window');
    const lessonContext = document.getElementById('lesson-context').value;
    
    const question = inputField.value.trim();
    if (!question) return;

    chatWindow.innerHTML += `<div class="chat-bubble bubble-student">${question}</div>`;
    inputField.value = '';
    
    const loadingId = 'loading-' + Date.now();
    chatWindow.innerHTML += `<div id="${loadingId}" class="ai-typing-indicator"><%= __('lesson_ai_thinking') %></div>`;
    chatWindow.scrollTop = chatWindow.scrollHeight;

    try {
      const enrichedQuestion = `[<%= __('lesson_ai_context') %>: ${lessonContext}] <%= __('lesson_ai_student_question') %>: ${question}`;

      const response = await fetch('/ask-tutor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentQuestion: enrichedQuestion })
      });
      
      const data = await response.json();
      document.getElementById(loadingId).remove();

      if (data.answer) {
        let formattedAnswer = data.answer
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n/g, '<br>');
            
        chatWindow.innerHTML += `<div class="chat-bubble bubble-ai">${formattedAnswer}</div>`;
      } else {
        chatWindow.innerHTML += `<div class="chat-bubble bubble-ai bubble-error"><%= __('lesson_ai_error') %>: ${data.error}</div>`;
      }
    } catch (error) {
      document.getElementById(loadingId).remove();
      chatWindow.innerHTML += `<div class="chat-bubble bubble-ai bubble-error"><%= __('lesson_ai_connection_error') %></div>`;
    }
    
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }
</script>
<!-- ========================================== -->

