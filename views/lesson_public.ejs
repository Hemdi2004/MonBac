<%
  const displayResourceName = (filename) => {
    const safeFilename = String(filename || "");
    try {
      return decodeURIComponent(escape(safeFilename)).replace(/\.pdf$/i, "");
    } catch (error) {
      return safeFilename.replace(/\.pdf$/i, "");
    }
  };
%>

<nav class="breadcrumb">
  <a href="/">Accueil</a>
  <span class="sep">›</span>
  <a href="/course/<%= lesson.course_slug %>"><%= lesson.course_title %></a>
  <span class="sep">›</span>
  <span class="current"><%= lesson.title %></span>
</nav>
<a class="btn btn-secondary return-btn" href="javascript:history.back()">← Retour</a>
<div class="lesson-layout">

  <!-- Sidebar TOC -->
  <aside class="toc card">
    <h3 class="toc-title">Plan du cours</h3>

    <%
      const grouped = {};
      (toc || []).forEach(row => {
        if (!grouped[row.chapter_id]) {
          grouped[row.chapter_id] = { title: row.chapter_title, lessons: [] };
        }
        if (row.lesson_id) {
          grouped[row.chapter_id].lessons.push({
            id: row.lesson_id,
            title: row.lesson_title
          });
        }
      });

      const chapterOrder = [];
      const seen = new Set();
      (toc || []).forEach(r => {
        if (!seen.has(r.chapter_id)) {
          seen.add(r.chapter_id);
          chapterOrder.push(r.chapter_id);
        }
      });
    %>

    <div class="toc-groups">
      <% chapterOrder.forEach(chId => { %>
        <section class="toc-group">
          <div class="toc-chapter"><%= grouped[chId].title %></div>

          <ul class="toc-list">
            <% grouped[chId].lessons.forEach(ls => { 
                 const isActive = Number(ls.id) === Number(lesson.id);
            %>
              <li>
                <a class="toc-link <%= isActive ? 'active' : '' %>" href="/lesson/<%= ls.id %>">
                  <%= ls.title %>
                </a>
              </li>
            <% }) %>
          </ul>
        </section>
      <% }) %>
    </div>
  </aside>

  <!-- Main lesson content -->
  <section class="lesson-main">
    <header class="lesson-header">
      <h1 class="lesson-title"><%= lesson.title %></h1>
      <p class="lesson-meta">
        Chapitre : <strong><%= lesson.chapter_title %></strong>
      </p>
    </header>

    <% if (lesson.content) { %>
      <div class="lesson-content card">
        <p><%= lesson.content %></p>
      </div>
    <% } %>

   <section class="lesson-body">
  <% if (lesson.objective && lesson.objective.trim()) { %>
    <div class="card lesson-panel">
      <h2>Objectif de la leçon</h2>
      <p class="muted"><%= lesson.objective %></p>
    </div>
  <% } %>

  <% if (lesson.exam_points && lesson.exam_points.trim()) { %>
    <div class="card lesson-panel">
      <h2>Ce qui tombe à l’examen</h2>
      <ul class="bullets">
        <% lesson.exam_points.split('\n').forEach(line => { %>
          <% if (line.trim()) { %>
            <li><%= line %></li>
          <% } %>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (lesson.common_mistakes && lesson.common_mistakes.trim()) { %>
    <div class="card lesson-panel">
      <h2>Erreurs fréquentes</h2>
      <ul class="bullets">
        <% lesson.common_mistakes.split('\n').forEach(line => { %>
          <% if (line.trim()) { %>
            <li><%= line %></li>
          <% } %>
        <% }) %>
      </ul>
    </div>
  <% } %>
</section>
    <section class="resources">
      <h2 class="section-title">Ressources</h2>

      <div class="resource-block">
        <h3>Explications</h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'explanation').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'explanation')) { %>
            <div style="padding: 1rem; border: 1px dashed #e5e7eb; border-radius: 12px; background: #f9fafb; display: flex; align-items: center; gap: 10px;">
              <i data-lucide="file-question" style="width: 24px; height: 24px; color: #d1d5db;"></i>
              <p style="color: #9ca3af; margin: 0; font-size: 0.95rem;">Aucune explication pour le moment.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resource-block">
        <h3>Exercices</h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'exercise').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'exercise')) { %>
            <div style="padding: 1rem; border: 1px dashed #e5e7eb; border-radius: 12px; background: #f9fafb; display: flex; align-items: center; gap: 10px;">
              <i data-lucide="file-question" style="width: 24px; height: 24px; color: #d1d5db;"></i>
              <p style="color: #9ca3af; margin: 0; font-size: 0.95rem;">Aucun exercice pour le moment.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="resource-block">
        <h3>Solutions</h3>
        <div class="resource-list">
          <% (files || []).filter(f => f.category === 'solution').forEach(f => { %>
            <a class="resource-item" href="/files/<%= f.id %>">
              <span class="resource-title"><i data-lucide="file-text" class="resource-icon" aria-hidden="true"></i><span class="resource-name"><%= displayResourceName(f.original_name) %></span></span>
              <span class="resource-meta">PDF</span>
            </a>
          <% }) %>
          <% if (!(files || []).some(f => f.category === 'solution')) { %>
            <div style="padding: 1rem; border: 1px dashed #e5e7eb; border-radius: 12px; background: #f9fafb; display: flex; align-items: center; gap: 10px;">
              <i data-lucide="file-question" style="width: 24px; height: 24px; color: #d1d5db;"></i>
              <p style="color: #9ca3af; margin: 0; font-size: 0.95rem;">Aucune solution pour le moment.</p>
            </div>
          <% } %>
        </div>
      </div>
    </section>

<!-- ==========================================
     NEMOTRON AI TUTOR COMPONENT (Hackathon)
     ========================================== -->
<style>
  .ai-tutor-container {
    background-color: #F8FAFC;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }
  .ai-tutor-header {
    color: #0F172A;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ai-chat-window {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 400px;
    overflow-y: auto;
    padding-inline-end: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .chat-bubble {
    max-width: 85%;
    padding: 1rem 1.25rem;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .bubble-student {
    align-self: flex-end;
    background-color: #2563EB;
    color: #ffffff;
    border-start-end-radius: 16px;
    border-start-start-radius: 16px;
    border-end-start-radius: 16px;
    border-end-end-radius: 4px;
    margin-inline-start: auto;
  }
  .bubble-ai {
    align-self: flex-start;
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    border-start-end-radius: 16px;
    border-start-start-radius: 16px;
    border-end-end-radius: 16px;
    border-end-start-radius: 4px;
    margin-inline-end: auto;
  }
  .ai-input-wrapper {
    display: flex;
    gap: 0.75rem;
  }
  .ai-input-field {
    flex-grow: 1;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 999px; 
    padding: 0.75rem 1.5rem;
    color: #0F172A;
    outline: none;
    transition: all 0.2s ease;
  }
  .ai-input-field:focus {
    border-color: #2563EB;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }
  .ai-btn-submit {
    background-color: #2563EB;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s;
  }
  .ai-btn-submit:hover {
    background-color: #1d4ed8;
  }
  .ai-btn-submit:active {
    transform: scale(0.97);
  }
  .ai-typing-indicator {
    color: #9ca3af;
    font-size: 0.85rem;
    font-style: italic;
    align-self: flex-start;
    padding-inline-start: 1rem;
  }
</style>

<section class="ai-tutor-container card">
  <div class="ai-tutor-header">
    <span style="font-size: 1.5rem;">🤖</span> 
    Assistant IA : <%= lesson.title %>
  </div>
  
  <div id="ai-chat-window" class="ai-chat-window">
    <div class="chat-bubble bubble-ai">
      Bonjour ! Je suis l'assistant IA propulsé par <strong>NVIDIA Nemotron</strong>. As-tu une question sur le chapitre <em><%= lesson.chapter_title %></em> ?
    </div>
  </div>

  <div class="ai-input-wrapper">
    <input type="hidden" id="lesson-context" value="Chapitre: <%= lesson.chapter_title %> | Leçon: <%= lesson.title %>">
    
    <input type="text" id="ai-input-field" class="ai-input-field" placeholder="Pose ta question ici..." onkeypress="if(event.key === 'Enter') submitAiQuestion()">
    <button class="ai-btn-submit" onclick="submitAiQuestion()">Demander</button>
  </div>
</section>

<script>
  async function submitAiQuestion() {
    const inputField = document.getElementById('ai-input-field');
    const chatWindow = document.getElementById('ai-chat-window');
    const lessonContext = document.getElementById('lesson-context').value;
    
    const question = inputField.value.trim();
    if (!question) return;

    chatWindow.innerHTML += `<div class="chat-bubble bubble-student">${question}</div>`;
    inputField.value = '';
    
    const loadingId = 'loading-' + Date.now();
    chatWindow.innerHTML += `<div id="${loadingId}" class="ai-typing-indicator">L'IA réfléchit...</div>`;
    chatWindow.scrollTop = chatWindow.scrollHeight;

    try {
      const enrichedQuestion = `[Contexte de la leçon: ${lessonContext}] Question de l'élève: ${question}`;

      const response = await fetch('/ask-tutor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentQuestion: enrichedQuestion })
      });
      
      const data = await response.json();
      document.getElementById(loadingId).remove();

      if (data.answer) {
        let formattedAnswer = data.answer
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n/g, '<br>');
            
        chatWindow.innerHTML += `<div class="chat-bubble bubble-ai">${formattedAnswer}</div>`;
      } else {
        chatWindow.innerHTML += `<div class="chat-bubble bubble-ai" style="color: #ef4444;">Erreur: ${data.error}</div>`;
      }
    } catch (error) {
      document.getElementById(loadingId).remove();
      chatWindow.innerHTML += `<div class="chat-bubble bubble-ai" style="color: #ef4444;">Erreur de connexion au serveur.</div>`;
    }
    
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }
</script>
